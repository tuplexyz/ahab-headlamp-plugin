{
  "name": "ahab-headlamp-plugin",
  "version": "0.1.0",
  "description": "Headlamp and AKS Desktop plugin for managing Ahab scientific workloads",
  "scripts": {
    "start": "headlamp-plugin start",
    "build": "headlamp-plugin build",
    "format": "headlamp-plugin format",
    "lint": "headlamp-plugin lint",
    "lint-fix": "headlamp-plugin lint --fix",
    "package": "headlamp-plugin package",
    "tsc": "headlamp-plugin tsc",
    "test": "vitest run -c vitest.config.ts"
  },
  "keywords": [
    "headlamp",
    "aks-desktop",
    "kubernetes",
    "scientific-computing",
    "ahab"
  ],
  "prettier": "@headlamp-k8s/eslint-config/prettier-config",
  "eslintConfig": {
    "extends": [
      "@headlamp-k8s",
      "prettier",
      "plugin:jsx-a11y/recommended"
    ]
  },
  "overrides": {
    "@vitest/coverage-istanbul": "^5.1.0",
    "rollup": "^4.59.0",
    "typescript": "5.6.2",
    "vitest": "^5.1.0",
    "webpack-dev-middleware": "^7.4.6"
  },
  "devDependencies": {
    "@kinvolk/headlamp-plugin": "^0.14.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.3",
    "jsdom": "^24.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vitest": "^5.1.0"
  }
}
